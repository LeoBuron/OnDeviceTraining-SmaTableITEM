Bootstrap: docker
From: ubuntu:22.04

# CPU-only container for the SmaTable HPC harness on Amplitude. No CUDA —
# every Optuna trial is an FP32 ODT subprocess run on CPU. The diff vs.
# the reference smatable-offline container is exactly that: drop CUDA,
# drop torch (lazy: optuna alone is enough), and bake the build toolchain
# we need to compile per-RQ HOST binaries inside the image.
#
# Note on FetchContent: pico-sdk + OnDeviceTraining are NOT fetched here.
# `cmake --preset PREPARE` runs outside the container on the login node so
# the source tree (and its Lustre-resident pico-sdk/ODT clones) persists
# across jobs without rebuilding the image.

%files
    pyproject.toml /app/pyproject.toml
    uv.lock        /app/uv.lock

%post
    set -eu

    # Amplitude's login nodes export http_proxy=134.91.129.97://3128 — note
    # the "://" between host and port instead of ":". apt-get rejects this with
    # "Unsupported proxy configured: 134.91.129.97://3128". Apptainer 1.x
    # propagates the proxy env vars into %post by default, so we normalize
    # them in-place: strip any leading scheme, collapse host://port to
    # host:port, then re-prepend a single http:// scheme. No-op when no
    # proxy is set (local Mac builds). POSIX-only — sh is dash on ubuntu:22.04.
    for var in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY; do
        eval "val=\${$var:-}"
        if [ -z "$val" ]; then continue; fi
        case "$val" in
            http://*)  val="${val#http://}"  ;;
            https://*) val="${val#https://}" ;;
        esac
        case "$val" in
            *://*) val="${val%%://*}:${val#*://}" ;;
        esac
        eval "export $var=\"http://$val\""
    done

    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates curl git \
        clang ninja-build cmake \
        python3
    rm -rf /var/lib/apt/lists/*

    # The astral.sh installer is NOT on Amplitude's proxy whitelist (github.com
    # is). Pull the uv release tarball directly — same pattern as
    # scripts/amplitude/20_setup.sh, just bound for /usr/local/bin in the image.
    UV_REL_URL="https://github.com/astral-sh/uv/releases/latest/download/uv-x86_64-unknown-linux-gnu.tar.gz"
    tmp="$(mktemp -d)"
    curl -fsSL "$UV_REL_URL" -o "${tmp}/uv.tar.gz"
    tar -xzf "${tmp}/uv.tar.gz" -C "${tmp}"
    cp "${tmp}/uv-x86_64-unknown-linux-gnu/uv"  /usr/local/bin/uv
    cp "${tmp}/uv-x86_64-unknown-linux-gnu/uvx" /usr/local/bin/uvx
    chmod +x /usr/local/bin/uv /usr/local/bin/uvx
    rm -rf "${tmp}"

    export UV_PYTHON_INSTALL_DIR=/opt/uv/python
    export UV_CACHE_DIR=/tmp/uv-cache
    export UV_PROJECT_ENVIRONMENT=/app/.venv

    cd /app
    uv python install
    # --no-dev drops the [dependency-groups.dev] entries (torch + its CUDA
    # wheels), keeping the image at ~500 MB. torch is only used by the local
    # PyTorch reference scripts which never run inside the container.
    uv sync --no-dev

%environment
    export PATH=/usr/local/bin:$PATH
    export UV_PYTHON_INSTALL_DIR=/opt/uv/python
    export UV_CACHE_DIR=${UV_CACHE_DIR:-/tmp/uv-cache}
    export UV_PROJECT_ENVIRONMENT=/app/.venv

%runscript
    cd /app
    # --no-dev mirrors the build-time `uv sync --no-dev`. Without it, `uv run`
    # would re-resolve the project and try to install the dev group (torch +
    # nvidia-* CUDA wheels) on every container start — failing on Amplitude
    # because PyPI / files.pythonhosted.org are not on the proxy whitelist.
    exec uv run --no-dev "$@"
